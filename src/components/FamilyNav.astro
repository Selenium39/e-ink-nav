---
import { FAMILY } from '../config';
import { localePath, useUi, type Locale } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug = '' } = Astro.props;
const ui = useUi(locale);
---

<header class="family">
  <div class="wrap family-row">
    <nav aria-label={ui.familyLabel}>
      <ul>
        {
          FAMILY.map((item) => {
            const href = item.id === 'nav' ? localePath(locale) : item.href;
            const label = ui.family[item.id];
            const current = item.id === 'nav';
            return (
              <li>
                <a
                  href={href}
                  aria-current={current ? 'page' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="tools">
      <LangSwitch locale={locale} slug={slug} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
