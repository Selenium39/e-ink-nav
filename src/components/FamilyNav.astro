---
import { FAMILY, SITE_NAME } from '../config';
import { localePath, useUi, type Locale } from '../i18n/ui';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  slug?: string;
  home?: boolean;
}

const { locale, slug = '', home = false } = Astro.props;
const ui = useUi(locale);
---

<header class="family">
  <div class="wrap family-row">
    <div class="brand-row">
      <a class="logo" href={localePath(locale)}>{SITE_NAME}</a>
      <nav aria-label={ui.familyLabel}>
        <ul>
          {
            FAMILY.map((item) => {
              const label = ui.family[item.id];
              const current = item.id === 'nav' && home;
              return (
                <li>
                  <a
                    href={item.href}
                    aria-current={current ? 'page' : undefined}
                    rel={item.external ? 'noopener noreferrer' : undefined}
                  >
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
    <div class="tools">
      <LangSwitch locale={locale} slug={slug} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>
