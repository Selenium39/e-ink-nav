---
import { hreflang, htmlLang, localePath, locales, useUi, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  slug?: string;
}

const { locale, slug = '' } = Astro.props;
const ui = useUi(locale);
---

<nav class="lang-switch" aria-label={ui.langLabel}>
  {
    locales.map((code) => (
      <a
        data-lang-link
        href={localePath(code, slug)}
        hreflang={hreflang[code]}
        lang={htmlLang[code]}
        aria-current={code === locale ? 'page' : undefined}
      >
        {ui.lang[code]}
      </a>
    ))
  }
</nav>
