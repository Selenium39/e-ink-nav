---
import { categories, entriesIn } from '../lib/catalog';
import { localePath, useUi, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  current?: string;
  /** 'page' when the current page IS this category index; 'location' when it is merely an ancestor. */
  currentState?: 'page' | 'location';
}

const { locale, current, currentState = 'page' } = Astro.props;
const ui = useUi(locale);
---

<div class="cat-band">
  <nav class="wrap" aria-label={ui.categoriesNav}>
    <ul>
      {
        categories.map((category) => (
          <li>
            <a
              href={localePath(locale, category.slug)}
              aria-current={category.slug === current ? currentState : undefined}
            >
              {category.title[locale]}
              <span class="count">{entriesIn(category.slug).length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
