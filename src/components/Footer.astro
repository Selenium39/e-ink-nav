---
import { CONTACT_EMAIL, FAMILY } from '../config';
import { localePath, useUi, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const subject = encodeURIComponent(ui.mailSubject);
---

<footer class="footer">
  <div class="wrap">
    <nav aria-label={ui.footerFamily}>
      <ul>
        {
          FAMILY.map((item) => {
            const href = item.id === 'nav' ? localePath(locale) : item.href;
            return (
              <li>
                <a href={href} rel={item.external ? 'noopener noreferrer' : undefined}>
                  {ui.family[item.id]}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <p>
      {ui.footerSuggest}{' '}
      <a href={`mailto:${CONTACT_EMAIL}?subject=${subject}`}>{CONTACT_EMAIL}</a>
    </p>
    <p>{ui.footerLegal}</p>
  </div>
</footer>
