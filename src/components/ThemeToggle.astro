---
import { useUi, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label={ui.theme.toggle}>
  <span class="when-light">{ui.theme.toDark}</span>
  <span class="when-dark">{ui.theme.toLight}</span>
</button>
