---
import '../styles/global.css';
import FamilyNav from '../components/FamilyNav.astro';
import Footer from '../components/Footer.astro';
import { UMAMI_SCRIPT_SRC, UMAMI_WEBSITE_ID } from '../config';
import { absoluteUrl, hreflang, htmlLang, localePath, locales, useUi, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  slug?: string;
  jsonLd?: Record<string, unknown>;
  robots?: string;
}

const { locale, title, description, slug = '', jsonLd, robots = 'index,follow' } = Astro.props;
const ui = useUi(locale);
const path = localePath(locale, slug);
const canonical = absoluteUrl(path);
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((code) => (
        <link rel="alternate" hreflang={hreflang[code]} href={absoluteUrl(localePath(code, slug))} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localePath('en', slug))} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#FAF9F6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0A0A" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    {json && <script type="application/ld+json" set:html={json} />}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>
    {
      UMAMI_WEBSITE_ID !== '' && (
        <script is:inline defer src={UMAMI_SCRIPT_SRC} data-website-id={UMAMI_WEBSITE_ID} />
      )
    }
  </head>
  <body>
    <a class="skip" href="#content">{ui.skip}</a>
    <FamilyNav locale={locale} slug={slug} />
    <slot />
    <Footer locale={locale} />
    <script>
      import { initSite } from '../scripts/site.ts';
      initSite();
    </script>
  </body>
</html>
