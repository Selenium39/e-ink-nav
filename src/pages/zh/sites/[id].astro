---
import Entry from '../../../views/Entry.astro';
import { entries } from '../../../lib/catalog';

export function getStaticPaths() {
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { id: entry.id },
  }));
}

const { id } = Astro.props;
---

<Entry locale="zh" id={id} />
